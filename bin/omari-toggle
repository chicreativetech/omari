#!/bin/bash
# Turns one of Omari's Hyprland configs on or off and reloads Hyprland.
#
#   omari-toggle <mode|overview|alttab|all> [on|off|toggle|status]
#
# The lua sources live next to this script, inside the plugin directory, and
# this script finds them relative to itself. Installing the plugin is therefore
# the whole install: nothing has to be copied into ~/.config/hypr or
# ~/.config/omarchy/bar/scripts first, and flipping a switch in the bar applies
# the config on a machine that has never seen Omari before.
#
# Turning one on copies its source into
# ~/.local/state/omarchy/toggles/hypr/omari-<name>.lua, the directory Omarchy's
# default toggle loader sources on every reload -- the same contract
# omarchy-hyprland-toggle uses for Omarchy's own flags, just sourced from the
# plugin instead of $OMARCHY_PATH.
#
# `mode` carries the other two with it. The overview draws the scrolling
# layout's workspaces and Alt-Tab walks the same tape, so neither is meant to
# be left running on a stock Hyprland layout: turning the mode off takes them
# down, and turning it back on puts back exactly the ones that were up. What
# was up is remembered in $XDG_STATE_HOME/omari/suspended -- deliberately not
# in the toggles directory, which is sourced as lua.

set -euo pipefail

usage() {
  echo "Usage: omari-toggle <mode|overview|alttab|all> [on|off|toggle|status]" >&2
}

if (($# < 1)); then
  usage
  exit 1
fi

NAME="$1"
ACTION="${2:-toggle}"

# BASH_SOURCE rather than $0: this is also run as `bash <path>/omari-toggle`,
# where the plugin directory may have lost its executable bits (a zip download,
# a copy across filesystems), and $0 is then the path bash was handed anyway.
PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
TOGGLES_DIR="$STATE_HOME/omarchy/toggles/hypr"
SUSPENDED_FILE="$STATE_HOME/omari/suspended"

# The configs `mode` pulls along behind it, in the order the popup lists them.
COMPANIONS=(overview alttab)

flag_file() {
  echo "$TOGGLES_DIR/omari-$1.lua"
}

is_on() {
  [[ -f $(flag_file "$1") ]]
}

# Copy the source in rather than symlink it: the toggles directory is Omarchy's
# state, and a link into a plugin directory that gets moved or deleted would
# leave a reload sourcing a dangling path.
on() {
  local name="$1"
  local source="$PLUGIN_DIR/hypr/omari-$name.lua"
  local flag
  flag="$(flag_file "$name")"
  if [[ ! -f $source ]]; then
    echo "Missing $source -- the plugin install is incomplete." >&2
    exit 1
  fi
  mkdir -p "$(dirname "$flag")"
  # Copy to a temp file in the destination directory and rename it into place,
  # so a reload triggered while the copy is in flight never sources a half
  # written lua file.
  local tmp
  tmp="$(mktemp "$(dirname "$flag")/.omari-$name.XXXXXX")"
  cp "$source" "$tmp"
  # mktemp creates 0600 and the rename carries that over, which would leave
  # the flag file more restrictive than the plain `cp` this replaced. Nothing
  # reads it but this user's Hyprland, so the mode is cosmetic -- but a
  # toggles directory where one file looks different invites a second look.
  chmod 644 "$tmp"
  mv -f "$tmp" "$flag"
}

off() {
  rm -f "$(flag_file "$1")"
}

# ------------------------------------------------------------ mode's cascade
#
# Written before anything is turned off, read after the mode is back on, and
# gone either way once it has been used. An empty file is a real answer -- "the
# mode went down with both companions already off" -- so its *existence* is
# never used as the question; the names in it are.
suspend_companions() {
  local name suspended=()
  for name in "${COMPANIONS[@]}"; do
    if is_on "$name"; then
      suspended+=("$name")
      off "$name"
    fi
  done
  mkdir -p "$(dirname "$SUSPENDED_FILE")"
  : >"$SUSPENDED_FILE"
  if ((${#suspended[@]})); then
    printf '%s\n' "${suspended[@]}" >"$SUSPENDED_FILE"
  fi
}

resume_companions() {
  [[ -f $SUSPENDED_FILE ]] || return 0
  local name
  while IFS= read -r name; do
    # Only ever the two names this script writes. A hand-edited file, or one
    # left by a future version that knows a third config, must not be able to
    # talk this one into copying an arbitrary path into the toggles directory.
    case $name in
      overview | alttab) on "$name" ;;
    esac
  done <"$SUSPENDED_FILE"
  rm -f "$SUSPENDED_FILE"
}

case $NAME in
  mode | overview | alttab) ;;
  all)
    if [[ $ACTION != off ]]; then
      echo "The 'all' target only supports the 'off' action." >&2
      usage
      exit 1
    fi
    rm -f "$TOGGLES_DIR/omari-mode.lua" \
      "$TOGGLES_DIR/omari-overview.lua" \
      "$TOGGLES_DIR/omari-alttab.lua"
    # Everything is off by request, so there is nothing suspended to come back:
    # leaving the memo would resurrect the overview on the next `mode on`.
    rm -f "$SUSPENDED_FILE"
    hyprctl reload >/dev/null 2>&1 || true
    echo "off"
    exit 0
    ;;
  *)
    echo "Unknown Omari config: $NAME" >&2
    usage
    exit 1
    ;;
esac

FLAG_FILE="$(flag_file "$NAME")"

# `status` answers about one flag and changes nothing, so it is out before the
# cascade below has a chance to have an opinion.
if [[ $ACTION == status ]]; then
  [[ -f $FLAG_FILE ]] && echo "on" || echo "off"
  exit 0
fi

# Resolve `toggle` to the state being asked for, so the cascade has one thing
# to test instead of the same file twice.
if [[ $ACTION == toggle ]]; then
  if [[ -f $FLAG_FILE ]]; then ACTION=off; else ACTION=on; fi
fi

case $ACTION in
  on)
    on "$NAME"
    # `if` rather than `[[ ... ]] && ...`: a failed test as the last command of
    # a case branch is a non-zero status for the whole case, and `set -e` reads
    # that as the script having failed -- which it did, silently, for every
    # `omari-toggle overview on` this was written with.
    if [[ $NAME == mode ]]; then
      resume_companions
    fi
    ;;
  off)
    # Companions first: they are taken down while the mode is still nominally
    # on, so a reload racing this never sees an overview bound over a layout
    # that is no longer scrolling.
    if [[ $NAME == mode ]]; then
      suspend_companions
    fi
    off "$NAME"
    ;;
  *)
    usage
    exit 1
    ;;
esac

# A reload is what actually applies the change -- one for the whole cascade,
# not one per flag. Hyprland not running (the shell under a nested session, a
# reload racing a compositor restart) is not a reason to report the toggle
# itself as failed -- the flag files are already correct and the next reload
# picks them up.
hyprctl reload >/dev/null 2>&1 || echo "Config written, but 'hyprctl reload' failed." >&2

[[ -f $FLAG_FILE ]] && echo "on" || echo "off"
